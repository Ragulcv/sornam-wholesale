# Production database. Use the DIRECT host, not the -pooler one (the service
# strips "-pooler" itself if you paste the pooled URL).
BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@ep-dark-silence-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Encrypts every backup file (AES-256, openssl). Without it a backup cannot be
# opened, so store it somewhere other than this server too.
BACKUP_PASSPHRASE=change-me-to-a-long-random-string

# Shared with the Wholesale app (Vercel env BACKUP_API_KEY) for the Settings card.
BACKUP_API_KEY=change-me-to-another-long-random-string

# 24h clock, Asia/Kolkata
BACKUP_TIME=23:30
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12

# Comma-separated. Only "local" exists today; the second destination plugs in
# here after go-live (see destinations/README.md).
BACKUP_DESTINATIONS=local
PORT=4100
